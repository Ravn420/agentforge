{
  "name": "agentforge-merged",
  "version": "1.0.0",
  "description": "Merged AgentForge: carnival backend + studio frontend with deep research, media, PWA, Firebase",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:frontend": "vite",
