{
  "name": "TaskAttachment",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "extracted_text": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}