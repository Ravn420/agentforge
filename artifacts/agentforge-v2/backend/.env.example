# Carnival FastAPI backend environment
# Copy to .env and fill in values. Never commit real secrets.

# Required for OpenRouter LLM calls (or set via the UI / provider_settings)
OPENROUTER_API_KEY=

# Optional AWS Bedrock (uncomment and fill if using Bedrock)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Database path (defaults to backend/data/agentforge.db)
# DATABASE_PATH=./data/agentforge.db

# CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
