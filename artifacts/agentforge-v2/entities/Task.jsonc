{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "paused",
        "completed",
        "failed"
      ],
      "default": "queued"
    },
    "autonomy_level": {
      "type": "string",
      "enum": [
        "full_auto",
        "confirm_each_step",
        "manual"
      ],
      "default": "full_auto"
    },
    "max_steps": {
      "type": "number",
      "default": 10
    },
    "provider": {
      "type": "string",
      "enum": [
        "bedrock",
        "openrouter"
      ],
      "default": "openrouter"
    },
    "model_id": {
      "type": "string"
    },
    "final_summary": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    },
    "time_budget_minutes": {
      "type": "number",
      "default": 30
    }
  },
  "required": [
    "title",
    "goal",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}